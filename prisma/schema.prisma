generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id                 String   @id @default(cuid())
  name               String
  joinCode           String   @unique
  seasonLabel        String   @default("")
  playersOnField     Int      @default(8)
  defaultPeriodCount Int      @default(4)
  targetMinutes      Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  coaches       Coach[]
  players       Player[]
  games         Game[]
  slots         PositionSlot[]
  drills        Drill[]
  practicePlans PracticePlan[]
}

model PositionSlot {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  order     Int
  name      String
  group     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, order])
}

model Coach {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  role           String          @default("coach")
  teamId         String?
  team           Team?           @relation(fields: [teamId], references: [id])
  createdAt      DateTime        @default(now())
  sessions       Session[]
  passwordResets PasswordReset[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Player {
  id              String   @id
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  firstName       String
  lastNameInitial String   @default("")
  jerseyNumber    String   @default("")
  active          Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fieldTimestamps Json     @default("{}")

  availabilities      Availability[]
  assignments         Assignment[]
  practiceAttendances PracticeAttendance[]
}

model Game {
  id              String   @id
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date            DateTime
  opponent        String
  location        String   @default("")
  periodCount     Int
  status          String   @default("planned")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fieldTimestamps Json     @default("{}")

  availabilities Availability[]
  assignments    Assignment[]
  periods        GamePeriod[]
}

model GamePeriod {
  id           String    @id
  gameId       String
  game         Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  periodNumber Int
  status       String    @default("planned")
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([gameId, periodNumber])
}

model Availability {
  id        String   @id
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status    String   @default("available")
  updatedAt DateTime @updatedAt

  @@unique([gameId, playerId])
}

model Assignment {
  id               String   @id
  gameId           String
  game             Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  periodNumber     Int
  slotIndex        Int
  playerId         String?
  player           Player?  @relation(fields: [playerId], references: [id])
  isActual         Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  updatedByCoachId String?

  @@unique([gameId, periodNumber, slotIndex, isActual])
}

// ---------------------------------------------------------------------------
// Practice planning. Minute-based, deliberately separate from the
// period-based game side above — see the practice module design notes.
// ---------------------------------------------------------------------------

model Drill {
  id              String   @id
  teamId          String? // null only for the seed template rows (scope: "library"), never shown to users - every team gets its own copy at creation
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name            String
  slug            String   @default("")
  category        String // warmup | technical | small_sided_game | scrimmage | fun_finisher
  focusAreas      String[] @default([])
  defaultMinutes  Int
  minMinutes      Int?
  maxMinutes      Int?
  minPlayers      Int?
  maxPlayers      Int?
  equipment       String[] @default([])
  setup           String   @default("")
  instructions    String   @default("")
  coachingPoints  String[] @default([])
  progressions    String[] @default([])
  ageNotes        String   @default("")
  scope           String   @default("team") // library (seed template only) | team
  sourceDrillId   String?
  archived        Boolean  @default(false)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fieldTimestamps Json     @default("{}")

  blocks PracticeBlock[]
}

model PracticePlan {
  id              String    @id
  teamId          String
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date            DateTime?
  location        String    @default("")
  targetMinutes   Int       @default(30)
  status          String    @default("draft") // draft | planned
  notes           String    @default("")
  isTemplate      Boolean   @default(false)
  templateName    String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  fieldTimestamps Json      @default("{}")

  blocks     PracticeBlock[]
  attendance PracticeAttendance[]
}

model PracticeBlock {
  id             String       @id
  planId         String
  plan           PracticePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  order          Int
  type           String // drill | break | talk | free_play
  drillId        String?
  drill          Drill?       @relation(fields: [drillId], references: [id])
  plannedMinutes Int
  blockNotes     String       @default("")
  updatedAt      DateTime     @updatedAt
}

model PracticeAttendance {
  id        String       @id // `${planId}:${playerId}`
  planId    String
  plan      PracticePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status    String       @default("present") // present | absent
  updatedAt DateTime     @updatedAt

  @@unique([planId, playerId])
}
