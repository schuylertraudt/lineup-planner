# Postgres connection used by the app and by Prisma migrations.
DATABASE_URL="postgresql://lineup:lineup@db:5432/lineup?schema=public"

# Postgres container credentials (docker-compose only).
POSTGRES_USER=lineup
POSTGRES_PASSWORD=lineup
POSTGRES_DB=lineup

# Random string used to sign nothing sensitive beyond session token generation.
# Generate with: openssl rand -hex 32
SESSION_SECRET=changeme-generate-a-random-64-char-hex-string
